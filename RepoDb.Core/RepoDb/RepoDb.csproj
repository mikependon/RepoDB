<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDB</Title>
    <AssemblyName>RepoDb</AssemblyName>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>A hybrid ORM library for .NET.</Description>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>orm hybrid-orm micro-orm</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>http://repodb.net/release/core</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mikependon/RepoDb/tree/master/RepoDb.Core</RepositoryUrl>
    <!--
      When a dependent package (e.g. RepoDb.SqlServer) is packed with a global -p:Version, that
      version flows to this ProjectReference and gets stamped as the dependency version too. Pass
      -p:RepoDbCoreVersion=<version> to pin the version this project is referenced as, independently
      of the consuming package's own version. PackageVersion is used (not Version) because it is not
      overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbCoreVersion)' != ''">$(RepoDbCoreVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Reflection\DataCommand.cs" />
    <Compile Remove="Reflection\DelegateCache.cs" />
    <Compile Remove="Reflection\DelegateFactory.cs" />
    <Compile Remove="Reflection\Delegates.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageReference Include="System.Linq.Async" Version="7.0.1" />
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
    <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0" />
    <PackageReference Include="System.Reflection.TypeExtensions" Version="4.7.0" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.9" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Remove="System.Linq.Async" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="True" PackagePath="\" />
    <None Include="..\..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RepoDb.UnitTests" />
    <!--
      RepoDb.Oracle needs to rename Parameter.Name (internal setter) on WHERE-clause QueryFields
      before delegating to BaseStatementBuilder.CreateUpdate/CreateUpdateAll. Core unconditionally
      prepends "_" to WHERE-clause parameter names on Update operations (Parameter.PrependAnUnderscore,
      to avoid a SET/WHERE bind-name collision), which SQL Server/PostgreSQL tolerate (e.g. "@_Id" is a
      legal parameter name) but Oracle rejects (":_Id" is not a legal bind variable - identifiers must
      start with a letter), causing "ORA-00911: invalid character after". See RepoDb.Oracle's
      OracleStatementBuilder.CreateUpdate for the rename-in-place fix that requires this access.
    -->
    <InternalsVisibleTo Include="RepoDb.Oracle" />
    <!--
      RepoDb.Oracle.BulkOperations calls the internal Tracer/TraceResult classes directly so its bulk
      operations (BulkInsert/BulkMerge/BulkUpdate/BulkDelete) can raise the same Before/After execution
      trace events as the rest of RepoDb, even though the actual data transfer goes through
      OracleBulkCopy rather than a DbCommand that ExecuteNonQuery/ExecuteReader/etc. would trace for free.
    -->
    <InternalsVisibleTo Include="RepoDb.Oracle.BulkOperations" />
    <!--
      RepoDb.PostgreSql.BulkOperations calls the internal Tracer/TraceResult classes directly so its bulk
      operations (BulkInsert/BulkMerge/BulkUpdate/BulkDelete/BulkDeleteByKey) can raise the same Before/After
      execution trace events as the rest of RepoDb, even though the actual data transfer goes through
      NpgsqlBinaryImporter (via a pseudo/staging table) rather than a single DbCommand that
      ExecuteNonQuery/ExecuteReader/etc. would trace for free.
    -->
    <InternalsVisibleTo Include="RepoDb.PostgreSql.BulkOperations" />
  </ItemGroup>
</Project>
