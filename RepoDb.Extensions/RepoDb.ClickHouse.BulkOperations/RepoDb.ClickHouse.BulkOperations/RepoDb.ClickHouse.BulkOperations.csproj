<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.ClickHouse.BulkOperations</Title>
    <AssemblyName>RepoDb.ClickHouse.BulkOperations</AssemblyName>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <Description>An extension library that contains the official Bulk Operations of RepoDB for ClickHouse (using ClickHouse.Driver).</Description>
    <PackageTags>orm hybrid-orm micro-orm clickhouse bulkoperations</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDb/tree/master/RepoDb.Extensions/RepoDb.ClickHouse.BulkOperations</RepositoryUrl>
    <PackageReleaseNotes>http://repodb.net/release/clickhouseconnectorbulk</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-clickhouse</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package, independently of the consuming package's own -p:Version. Pass
      -p:RepoDbClickHouseBulkOperationsVersion=<version> to set it explicitly. PackageVersion is used (not
      Version) because it is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbClickHouseBulkOperationsVersion)' != ''">$(RepoDbClickHouseBulkOperationsVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\..\icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
    <ProjectReference Include="..\..\..\RepoDb.ClickHouse\RepoDb.ClickHouse\RepoDb.ClickHouse.csproj" />
  </ItemGroup>
</Project>
