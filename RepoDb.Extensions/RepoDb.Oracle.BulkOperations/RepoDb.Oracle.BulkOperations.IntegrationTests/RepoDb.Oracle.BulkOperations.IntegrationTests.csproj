<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <!--
      net8.0/net9.0/net10.0 all point at the same live Oracle schema/tables (there is no per-TFM
      isolation), so "dotnet test" running them as concurrent processes races: one TFM's
      Database.Cleanup() truncate or Bulk* direct-path load interleaves with another's, producing
      either row-count assertion failures or (for direct-path loads specifically) an intermittent
      "ORA-26028: index ... initially in unusable state". Serializing the TFMs avoids both.
    -->
    <TestTfmsInParallel>false</TestTfmsInParallel>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.2.3" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
    <ProjectReference Include="..\..\..\RepoDb.Oracle\RepoDb.Oracle\RepoDb.Oracle.csproj" />
    <ProjectReference Include="..\RepoDb.Oracle.BulkOperations\RepoDb.Oracle.BulkOperations.csproj" />
  </ItemGroup>
</Project>
