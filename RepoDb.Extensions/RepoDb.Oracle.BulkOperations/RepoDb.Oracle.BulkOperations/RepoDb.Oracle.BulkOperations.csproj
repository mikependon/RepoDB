<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.Oracle.BulkOperations</Title>
    <AssemblyName>RepoDb.Oracle.BulkOperations</AssemblyName>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <Description>An extension library that contains the official Bulk Operations of RepoDB for Oracle.</Description>
    <PackageTags>orm hybrid-orm micro-orm oracle odp.net bulkoperations</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDb/tree/master/RepoDb.Extensions/RepoDb.Oracle.BulkOperations</RepositoryUrl>
    <PackageReleaseNotes>http://repodb.net/release/oraclebulk</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-oracle</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package, independently of the consuming package's own -p:Version. Pass
      -p:RepoDbOracleBulkOperationsVersion=<version> to set it explicitly. PackageVersion is used (not
      Version) because it is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbOracleBulkOperationsVersion)' != ''">$(RepoDbOracleBulkOperationsVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\..\icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
    <ProjectReference Include="..\..\..\RepoDb.Oracle\RepoDb.Oracle\RepoDb.Oracle.csproj" />
  </ItemGroup>
</Project>
