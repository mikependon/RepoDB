<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.MariaDbConnector</Title>
    <AssemblyName>RepoDb.MariaDbConnector</AssemblyName>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>A hybrid .NET ORM library for MariaDB (using RepoDb.Connector.MariaDbConnector).</Description>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>orm hybrid-orm micro-orm mysql mariadb mariadbconnector</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDb/tree/master/RepoDb.MariaDbConnector</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>http://repodb.net/release/mariadbconnector</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-mysql</PackageProjectUrl>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package, independently of the consuming package's own -p:Version. Pass
      -p:RepoDbMariaDbConnectorVersion=<version> to set it. PackageVersion is used (not
      Version) because it is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbMariaDbConnectorVersion)' != ''">$(RepoDbMariaDbConnectorVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Attributes\MariaDbTypeMapAttribute.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RepoDb.Connector.MariaDbConnector" Version="0.0.1-alpha2" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
  </ItemGroup>
</Project>
