<Project>
  <!-- Every shipping library that targets net10.0+ is trim/AOT-analyzed. Test and benchmark projects are not. -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' And !$(MSBuildProjectName.Contains('Tests')) And !$(MSBuildProjectName.Contains('Benchmarks')) And !$(MSBuildProjectDirectory.Contains('Decommissioned')) And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
    <IsAotCompatible Condition="'$(IsAotCompatible)' == ''">true</IsAotCompatible>
  </PropertyGroup>
  <!-- Every shipping library (not tests, benchmarks or decommissioned) generates its XML documentation, so it is packed into the NuGet package (lib/<tfm>/<assembly>.xml). -->
  <PropertyGroup Condition="'$(TargetFramework)' != '' And !$(MSBuildProjectName.Contains('Tests')) And !$(MSBuildProjectName.Contains('Benchmarks')) And !$(MSBuildProjectDirectory.Contains('Decommissioned'))">
    <GenerateDocumentationFile Condition="'$(GenerateDocumentationFile)' == ''">true</GenerateDocumentationFile>
    <NoWarn Condition="'$(GenerateDocumentationFile)' == 'true'">$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.236">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
