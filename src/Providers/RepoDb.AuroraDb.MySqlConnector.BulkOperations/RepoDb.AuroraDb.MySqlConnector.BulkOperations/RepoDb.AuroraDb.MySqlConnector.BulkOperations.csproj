<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.AuroraDb.MySqlConnector.BulkOperations</Title>
    <PackageId>RepoDb.AuroraDb.MySqlConnector.BulkOperations</PackageId>
    <AssemblyName>RepoDb.AuroraDb.MySqlConnector.BulkOperations</AssemblyName>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <Description>An extension library that contains the official Bulk Operations of RepoDB for Amazon Aurora MySQL (using RepoDb.Connector.AuroraDb.MySqlConnector).</Description>
    <PackageTags>orm hybrid-orm micro-orm auroradb aurora aws amazon mysql mysqlconnector bulkoperations</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDB/tree/master/src/Providers/RepoDb.AuroraDb.MySqlConnector.BulkOperations</RepositoryUrl>
    <PackageReleaseNotes>http://repodb.net/release/auroradbmysqlconnectorbulk</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-auroradb-mysqlconnector</PackageProjectUrl>
    <PackageIcon>AuroraDB.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package, independently of the consuming package's own -p:Version. Pass
      -p:RepoDbAuroraDbMySqlConnectorBulkOperationsVersion=<version> to set it explicitly. PackageVersion is used (not
      Version) because it is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbAuroraDbMySqlConnectorBulkOperationsVersion)' != ''">$(RepoDbAuroraDbMySqlConnectorBulkOperationsVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\AuroraDB.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="RepoDb.Connector.AuroraDb.MySqlConnector" Version="0.0.1-alpha1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
    <ProjectReference Include="..\..\RepoDb.AuroraDb.MySqlConnector\RepoDb.AuroraDb.MySqlConnector\RepoDb.AuroraDb.MySqlConnector.csproj" />
  </ItemGroup>
</Project>
