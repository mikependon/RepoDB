<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.ClickHouse</Title>
    <AssemblyName>RepoDb.ClickHouse</AssemblyName>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>A hybrid .NET ORM library for ClickHouse (using ClickHouse.Driver).</Description>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>orm hybrid-orm micro-orm clickhouse olap</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDB/tree/master/RepoDb.ClickHouse</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>http://repodb.net/release/clickhouse</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-clickhouse</PackageProjectUrl>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package, independently of the consuming package's own -p:Version. Pass
      -p:RepoDbClickHouseVersion=<version> to set it. PackageVersion is used (not Version) because it
      is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbClickHouseVersion)' != ''">$(RepoDbClickHouseVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Attributes\ClickHouseTypeMapAttribute.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ClickHouse.Driver" Version="1.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\..\..\icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
  </ItemGroup>
</Project>
