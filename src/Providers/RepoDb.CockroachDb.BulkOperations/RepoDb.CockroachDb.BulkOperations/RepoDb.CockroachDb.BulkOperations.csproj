<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.CockroachDb.BulkOperations</Title>
    <AssemblyName>RepoDb.CockroachDb.BulkOperations</AssemblyName>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <Description>An extension library that contains the official Bulk Operations of RepoDB for CockroachDB (using RepoDb.Connector.CockroachDb).</Description>
    <PackageTags>orm hybrid-orm micro-orm cockroachdb cockroach bulkoperations</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDB/tree/master/src/Providers/RepoDb.CockroachDb.BulkOperations</RepositoryUrl>
    <PackageReleaseNotes>http://repodb.net/release/cockroachdbbulk</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-cockroachdb</PackageProjectUrl>
    <PackageIcon>CockroachDB.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package, independently of the consuming package's own -p:Version. Pass
      -p:RepoDbCockroachDbBulkOperationsVersion=<version> to set it explicitly. PackageVersion is used (not
      Version) because it is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbCockroachDbBulkOperationsVersion)' != ''">$(RepoDbCockroachDbBulkOperationsVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RepoDb.Connector.CockroachDb" Version="0.0.1-alpha1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\CockroachDB.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
    <ProjectReference Include="..\..\RepoDb.CockroachDb\RepoDb.CockroachDb\RepoDb.CockroachDb.csproj" />
  </ItemGroup>
</Project>
