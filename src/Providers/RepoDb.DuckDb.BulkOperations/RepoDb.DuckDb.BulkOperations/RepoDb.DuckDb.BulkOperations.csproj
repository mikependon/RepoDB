<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.DuckDb.BulkOperations</Title>
    <AssemblyName>RepoDb.DuckDb.BulkOperations</AssemblyName>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <Description>An extension library that contains the official Bulk Operations of RepoDB for DuckDB.</Description>
    <PackageTags>orm hybrid-orm micro-orm duckdb bulkoperations</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDB/tree/master/src/Providers/RepoDb.DuckDb.BulkOperations</RepositoryUrl>
    <PackageReleaseNotes>http://repodb.net/release/duckdbbulk</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-duckdb</PackageProjectUrl>
    <PackageIcon>DuckDB.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package, independently of the consuming package's own -p:Version. Pass
      -p:RepoDbDuckDbBulkOperationsVersion=<version> to set it explicitly. PackageVersion is used (not
      Version) because it is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbDuckDbBulkOperationsVersion)' != ''">$(RepoDbDuckDbBulkOperationsVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\DuckDB.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
    <ProjectReference Include="..\..\RepoDb.DuckDb\RepoDb.DuckDb\RepoDb.DuckDb.csproj" />
  </ItemGroup>
</Project>
