<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.EnterpriseDb</Title>
    <AssemblyName>RepoDb.EnterpriseDb</AssemblyName>
    <TargetFrameworks>net8;net10.0</TargetFrameworks>
    <Nullable>annotations</Nullable>
    <Description>A hybrid .NET ORM library for EDB Postgres Advanced Server (EnterpriseDB).</Description>
    <PackageTags>orm hybrid-orm micro-orm postgresql enterprisedb edb</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDb/tree/master/RepoDb.EnterpriseDb</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>http://repodb.net/release/enterprisedb</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-enterprisedb</PackageProjectUrl>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package (e.g. RepoDb.EnterpriseDb.BulkOperations), independently of the consuming package's own
      -p:Version. Pass -p:RepoDbEnterpriseDbVersion=<version> to set it. PackageVersion is used (not
      Version) because it is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbEnterpriseDbVersion)' != ''">$(RepoDbEnterpriseDbVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Attributes\EnterpriseDbTypeMapAttribute.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EnterpriseDB.EDBClient" Version="10.0.1.1" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Remove="System.Linq.Async" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\..\..\icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>
</Project>
