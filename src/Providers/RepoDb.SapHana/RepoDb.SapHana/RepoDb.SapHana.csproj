<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.SapHana</Title>
    <AssemblyName>RepoDb.SapHana</AssemblyName>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>A hybrid .NET ORM library for SAP HANA (using Sap.Data.Hana).</Description>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>orm hybrid-orm micro-orm saphana hana</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDb/tree/master/RepoDb.SapHana</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>http://repodb.net/release/saphana</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-saphana</PackageProjectUrl>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package (e.g. RepoDb.SapHana.BulkOperations), independently of the consuming package's own
      -p:Version. Pass -p:RepoDbSapHanaVersion=<version> to set it. PackageVersion is used (not
      Version) because it is not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbSapHanaVersion)' != ''">$(RepoDbSapHanaVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Attributes\SapHanaTypeMapAttribute.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\..\..\icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SAP HANA .NET Core ADO.NET provider. Confirmed to exist as of writing (namespace
         Sap.Data.Hana, targets net6.0+); pin/verify the exact version against what your HANA client
         install supports before publishing. -->
    <PackageReference Include="Sap.Data.Hana.Net.v6.0" Version="2.29.25" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
  </ItemGroup>
</Project>
