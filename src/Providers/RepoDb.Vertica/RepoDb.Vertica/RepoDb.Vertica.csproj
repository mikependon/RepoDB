<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>RepoDb.Vertica</Title>
    <AssemblyName>RepoDb.Vertica</AssemblyName>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>A hybrid .NET ORM library for Vertica (using Vertica.Data.VerticaClient).</Description>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>orm hybrid-orm micro-orm vertica verticasql</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDb/tree/master/RepoDb.Vertica</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>http://repodb.net/release/vertica</PackageReleaseNotes>
    <PackageProjectUrl>https://repodb.net/tutorial/get-started-vertica</PackageProjectUrl>
    <!--
      Pins the version this project is stamped as when it is a ProjectReference dependency of another
      package, independently of the consuming package's own -p:Version. Pass
      -p:RepoDbVerticaVersion=<version> to set it. PackageVersion is used (not Version) because it is
      not overridden by the global Version property.
    -->
    <PackageVersion Condition="'$(RepoDbVerticaVersion)' != ''">$(RepoDbVerticaVersion)</PackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vertica.Data" Version="24.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\..\..\..\icon.png" Pack="True" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\RepoDb.Core\RepoDb\RepoDb.csproj" />
  </ItemGroup>
</Project>
