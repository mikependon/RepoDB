<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]RepoDb\.Science\.Notebook\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <!-- The JSON serialization code is generated by the System.Text.Json source generator. -->
    <Sources>
      <Exclude>
        <Source>.*\.g\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
