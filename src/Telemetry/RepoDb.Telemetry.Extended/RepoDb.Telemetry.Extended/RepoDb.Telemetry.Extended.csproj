<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Title>RepoDb.Telemetry.Extended</Title>
    <AssemblyName>RepoDb.Telemetry.Extended</AssemblyName>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Description>The extended telemetry package for RepoDB library.</Description>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
    <PackageTags>orm hybrid-orm micro-orm telemetry</PackageTags>
    <RepositoryUrl>https://github.com/mikependon/RepoDB/tree/master/src/Telemetry/RepoDb.Telemetry.Extended</RepositoryUrl>
    <PackageReleaseNotes>http://repodb.net/release/telemetryextended</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageProjectUrl>https://repodb.net/</PackageProjectUrl>
    <PackageIcon>RepoDbTelemetry.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Providers\RepoDb.Core\RepoDb\RepoDb.csproj" />
    <ProjectReference Include="..\..\RepoDb.Telemetry.Default\RepoDb.Telemetry.Default\RepoDb.Telemetry.Default.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\LICENSE.txt" Pack="True" PackagePath="\" />
    <None Include="..\README.md" Pack="True" PackagePath="\" />
    <None Include="..\RepoDbTelemetry.png" Pack="True" PackagePath="\" />
  </ItemGroup>

</Project>
